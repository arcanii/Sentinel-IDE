// SPDX-License-Identifier: GPL-3.0-or-later
//
// parsers.sentinel — Sentinel-IDE's runtime PRODUCT logic, written in Sentinel and
// compiled into the shipped binary as ONE C-ABI static library (ADR 0059). Six
// exports the host used to do in C++ — five "interpret untrusted bytes" readers and
// the one writer that closes the loop:
//
//   parse_diag(line)     — one line of snc build output -> a diagnostic (file:line:col)
//   parse_trust(text)    — the consumer trust manifest -> the trusted [[keys]]
//   parse_sig(text)      — a detached-signature (.sig) carrier -> algorithm/key/grants
//   parse_manifest(text) — a project manifest -> the [project]/[build]/[signing] fields
//                          and the [[target]] blocks
//   save_manifest(text, model)
//                        — the old manifest + the managed values -> the new manifest
//                          text, rewritten surgically (the host does the file write)
//   parse_appcast(body, mine)
//                        — the update feed -> found/valid/newer + the version. The one
//                          input that comes off the NETWORK, and the only reader that
//                          also VALIDATES rather than merely transcribing.
//
// Kept as ONE lib on purpose: each Sentinel lib bundles the whole runtime, so linking
// several would collide on sentinel_free_bytes / the allocator. One lib = one runtime,
// so every port after the first adds only its own code (~8 KB), not another runtime.
// All use the owned `-> [u8]` return ABI (not `&mut [u8]`), sidestepping the
// header-emits-&mut-as-const defect (Sentinel-lang R3). Each export's record format is
// documented above it. The C++ fallbacks (MainWindow.cpp::parseDiag, Signing.h::
// loadTrust/readSig, Project.h::loadProject/saveProject) stay byte-identical, each
// guarded by a tests/ cross-check.
//
// ONE DELIBERATE DIVERGENCE, in save_manifest only: it is BYTE-TRANSPARENT, while the C++
// saveProject round-trips the file through UTF-16 (readUtf8 calls MultiByteToWideChar
// without MB_ERR_INVALID_CHARS), so the C++ rewrites every invalid UTF-8 byte to U+FFFD
// and this does not. It surfaces only on bytes inside a line the writer does not rewrite
// — a Latin-1 comment, an unmodeled value. Sentinel's behaviour is the better one, so it
// is kept rather than bug-compatibly broken; the cross-check feeds valid UTF-8, where the
// two agree exactly.

// ---- shared helpers ---------------------------------------------------------

// Append v as 8 little-endian bytes (`-> i64` returning 0 is the side-effect-only
// helper idiom; Sentinel has no unit-returning fn form).
fn push_le8(out: &mut Vec<u8>, v: i64) -> i64 {
    let mut i: i64 = 0;
    let mut x: i64 = v;
    while i < 8 {
        push(out, i64_to_u8(x - (x / 256) * 256));   // no `%` operator — x mod 256
        x = x / 256;
        i = i + 1;
    }
    0
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_alnum(c: u8) -> bool {
    (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

// The characters C++ `isPath` accepts, plus any byte >= 0x80 so multi-byte UTF-8
// path components (accented or non-Latin directory names) stay whole rather than
// truncating the token at the first continuation byte.
fn is_path(c: u8) -> bool {
    is_alnum(c) || c == '_' || c == '.' || c == '\\' || c == '/'
        || c == ':' || c == '-' || c == ' ' || (c as i64) >= 128
}

fn digit_val(c: u8) -> i64 {
    (c as i64) - ('0' as i64)
}

// True iff ".sentinel" (9 bytes) begins at `at` in `s` (length `n`). `&&`
// short-circuits, so the leading bounds test guards every index.
fn is_sentinel_at(s: &[u8], n: i64, at: i64) -> bool {
    at + 9 <= n
        && (*s)[at] == '.'
        && (*s)[at + 1] == 's' && (*s)[at + 2] == 'e' && (*s)[at + 3] == 'n'
        && (*s)[at + 4] == 't' && (*s)[at + 5] == 'i' && (*s)[at + 6] == 'n'
        && (*s)[at + 7] == 'e' && (*s)[at + 8] == 'l'
}

// Append an i64 as 8 little-endian bytes. `-> i64` returning 0 is the Sentinel
// idiom for a side-effect-only helper (there is no unit-returning fn form).
export "C" fn parse_diag(line: &[u8]) -> [u8] {
    let n: i64 = len(*line);

    // Function-scope state — Sentinel has no early `return`, so everything is
    // decided here and encoded once at the end, guarded by `matched`.
    let mut matched: bool = false;
    let mut ln: i64 = 0;
    let mut col: i64 = 1;
    let mut ts: i64 = 0;
    let mut te: i64 = 0;

    // First ".sentinel" (C++ uses find(), i.e. the earliest occurrence).
    let mut e: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i + 9 <= n && e < 0 {
        if is_sentinel_at(line, n, i) { e = i; 0 } else { 0 };
        i = i + 1;
    }

    // Require ".sentinel" then ":" then a digit. `&&` short-circuits, so each
    // index is bounded by the length test to its left.
    if e >= 0 && e + 9 < n && (*line)[e + 9] == ':' && e + 10 < n && is_digit((*line)[e + 10]) {
        // line number
        let mut q: i64 = e + 10;
        while q < n && is_digit((*line)[q]) {
            ln = ln * 10 + digit_val((*line)[q]);
            q = q + 1;
        }
        // optional ":col" — mirror C++ exactly: the colon is consumed the moment it
        // is seen (so the link span `te` includes a trailing `:` even when no column
        // digits follow, e.g. "file.sentinel:12: warning"); the column is only set if
        // digits are actually present.
        if q < n && (*line)[q] == ':' {
            q = q + 1;
            let mut c: i64 = 0;
            let mut any: bool = false;
            while q < n && is_digit((*line)[q]) {
                c = c * 10 + digit_val((*line)[q]);
                q = q + 1;
                any = true;
            }
            if any { col = c; 0 } else { 0 };
            0
        } else { 0 };
        // walk back to the start of the path token (stop at '[')
        let mut start: i64 = e;
        while start > 0 && is_path((*line)[start - 1]) && (*line)[start - 1] != '[' {
            start = start - 1;
        }
        // trim leading spaces to the real token start
        let mut t0: i64 = start;
        while t0 < n && (*line)[t0] == ' ' {
            t0 = t0 + 1;
        }
        ts = t0;
        te = q;
        matched = true;
        0
    } else { 0 };

    let mut out: Vec<u8> = vec_new();
    if matched {
        push(&mut out, i64_to_u8(1));
        push_le8(&mut out, ln);
        push_le8(&mut out, col);
        push_le8(&mut out, ts);
        push_le8(&mut out, te);
        // File token = line[ts .. fileEnd), fileEnd = end of the first ".sentinel"
        // at or after ts (the token always contains it, by construction).
        let mut je: i64 = ts;
        let mut found: bool = false;
        while je + 9 <= n && found == false {
            if is_sentinel_at(line, n, je) { found = true; 0 } else { je = je + 1; 0 };
        }
        let fileEnd: i64 = je + 9;
        let mut m: i64 = ts;
        while m < fileEnd {
            push(&mut out, (*line)[m]);
            m = m + 1;
        }
        0
    } else {
        push(&mut out, i64_to_u8(0));
        0
    };
    vec_to_array(out)
}

// ---- trust manifest parser --------------------------------------------------
fn is_ws(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// projUnq trims leading " \t" and trailing " \t\r" (note: not \n).
fn is_hsp(c: u8) -> bool {
    c == ' ' || c == '\t'
}
fn is_hsp_cr(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r'
}

// text[a..b) equals the literal `lit`, byte for byte.
fn lit_eq(text: &[u8], a: i64, b: i64, lit: [u8]) -> bool {
    let m: i64 = b - a;
    let ll: i64 = len(lit);
    let mut ok: bool = m == ll;
    let mut i: i64 = 0;
    while ok && i < ll {
        ok = ok && ((*text)[a + i] == lit[i]);
        i = i + 1;
    }
    ok
}

// Does text[a..b) contain the literal `lit` anywhere? (C++ uses find() != npos.)
fn range_has(text: &[u8], a: i64, b: i64, lit: [u8]) -> bool {
    let ll: i64 = len(lit);
    let mut found: bool = false;
    let mut i: i64 = a;
    while i + ll <= b && found == false {
        let mut m: bool = true;
        let mut j: i64 = 0;
        while m && j < ll {
            m = m && ((*text)[i + j] == lit[j]);
            j = j + 1;
        }
        if m { found = true; 0 } else { 0 };
        i = i + 1;
    }
    found
}

// Append v as 8 little-endian bytes.
// Append a length-prefixed byte range: [len i64 LE][ text[a..b) ].
fn push_lenpref(out: &mut Vec<u8>, text: &[u8], a: i64, b: i64) -> i64 {
    push_le8(out, b - a);
    let mut i: i64 = a;
    while i < b {
        push(out, (*text)[i]);
        i = i + 1;
    }
    0
}

// Emit the grant entries in text[a..b): each quoted string becomes { byte 1, lenpref }.
// Mirrors parseInlineArr: toggle on '"', emit the content when a quote closes.
fn emit_grants(out: &mut Vec<u8>, text: &[u8], a: i64, b: i64) -> i64 {
    let mut inq: bool = false;
    let mut cs: i64 = a;
    let mut i: i64 = a;
    while i < b {
        if (*text)[i] == '"' {
            if inq {
                push(out, i64_to_u8(1));
                push_lenpref(out, text, cs, i);
                inq = false;
                0
            } else {
                inq = true;
                cs = i + 1;
                0
            };
            0
        } else { 0 };
        i = i + 1;
    }
    0
}

// Emit one key record (name, pubkey, grants) then the grants terminator.
fn flush_key(out: &mut Vec<u8>, text: &[u8],
             hasN: bool, nA: i64, nB: i64,
             hasP: bool, pA: i64, pB: i64,
             hasG: bool, gA: i64, gB: i64) -> i64 {
    push(out, i64_to_u8(1));                 // a key follows
    if hasN { push_lenpref(out, text, nA, nB); 0 } else { push_le8(out, 0); 0 };
    if hasP { push_lenpref(out, text, pA, pB); 0 } else { push_le8(out, 0); 0 };
    if hasG { emit_grants(out, text, gA, gB); 0 } else { 0 };
    push(out, i64_to_u8(0));                 // grants terminator
    0
}

export "C" fn parse_trust(text: &[u8]) -> [u8] {
    let n: i64 = len(*text);
    let mut out: Vec<u8> = vec_new();

    // Pending-key state. Values are index RANGES into `text` (which lives for the
    // whole call), so nothing is copied until a key is flushed.
    let mut have: bool = false;
    let mut hasN: bool = false; let mut nA: i64 = 0; let mut nB: i64 = 0;
    let mut hasP: bool = false; let mut pA: i64 = 0; let mut pB: i64 = 0;
    let mut hasG: bool = false; let mut gA: i64 = 0; let mut gB: i64 = 0;

    // Walk the text line by line (split on '\n', a trailing '\r' trimmed by projTrim).
    let mut ls: i64 = 0;
    let mut i: i64 = 0;
    while i <= n {
        // A line ends at '\n' or at end-of-text.
        if i == n || (*text)[i] == '\n' {
            let la: i64 = ls;
            let lb: i64 = i;
            // projTrim: trim " \t\r\n" from both ends.
            let mut ts: i64 = la;
            while ts < lb && is_ws((*text)[ts]) { ts = ts + 1; }
            let mut te: i64 = lb;
            while te > ts && is_ws((*text)[te - 1]) { te = te - 1; }

            if ts < te && (*text)[ts] != '#' {
                if te - ts >= 2 && (*text)[ts] == '[' && (*text)[ts + 1] == '[' {
                    // [[...]] array-of-tables: flush any pending key, then open/close.
                    if have { flush_key(&mut out, text, hasN, nA, nB, hasP, pA, pB, hasG, gA, gB); 0 } else { 0 };
                    if range_has(text, ts, te, "keys") {
                        have = true; hasN = false; hasP = false; hasG = false; 0
                    } else {
                        have = false; 0
                    };
                    0
                } else {
                    if (*text)[ts] == '[' {
                        // any other single-bracket table closes the block.
                        if have { flush_key(&mut out, text, hasN, nA, nB, hasP, pA, pB, hasG, gA, gB); 0 } else { 0 };
                        have = false; 0
                    } else {
                        if have {
                            // find the first '=' in [ts, te)
                            let mut eq: i64 = ts;
                            let mut haseq: bool = false;
                            while eq < te && haseq == false {
                                if (*text)[eq] == '=' { haseq = true; 0 } else { eq = eq + 1; 0 };
                            }
                            if haseq {
                                // key range [ts, eq) trimmed to [ka, kb)
                                let mut ka: i64 = ts;
                                while ka < eq && is_ws((*text)[ka]) { ka = ka + 1; }
                                let mut kb: i64 = eq;
                                while kb > ka && is_ws((*text)[kb - 1]) { kb = kb - 1; }
                                // projUnq the raw value [eq+1, te): trim " \t" / " \t\r", strip a matched quote pair.
                                let mut ua: i64 = eq + 1;
                                while ua < te && is_hsp((*text)[ua]) { ua = ua + 1; }
                                let mut ub: i64 = te;
                                while ub > ua && is_hsp_cr((*text)[ub - 1]) { ub = ub - 1; }
                                if ub - ua >= 2 && (*text)[ua] == '"' && (*text)[ub - 1] == '"' { ua = ua + 1; ub = ub - 1; 0 } else { 0 };
                                // dispatch (grants uses the RAW value range, like parseInlineArr)
                                if lit_eq(text, ka, kb, "pubkey") {
                                    pA = ua; pB = ub; hasP = true; 0
                                } else {
                                    if lit_eq(text, ka, kb, "name") {
                                        nA = ua; nB = ub; hasN = true; 0
                                    } else {
                                        if lit_eq(text, ka, kb, "grants") {
                                            gA = eq + 1; gB = te; hasG = true; 0
                                        } else { 0 };
                                        0
                                    };
                                    0
                                };
                                0
                            } else { 0 };
                            0
                        } else { 0 };
                        0
                    };
                    0
                };
                0
            } else { 0 };

            ls = i + 1;
            0
        } else { 0 };
        i = i + 1;
    }

    // Flush the last pending key, then the no-more-keys terminator.
    if have { flush_key(&mut out, text, hasN, nA, nB, hasP, pA, pB, hasG, gA, gB); 0 } else { 0 };
    push(&mut out, i64_to_u8(0));
    vec_to_array(out)
}

// ---- detached-signature (.sig) carrier parser -------------------------------
//
// A faithful port of Signing.h::readSig. The `.sig` carrier is flat `key: value`
// lines; each line is split on the FIRST ':', both halves projTrim'd (note: plain
// trim, no quote stripping). Recognised keys (last-wins): algorithm, key, grants.
//
// Result record the host unpacks:
//   byte 0: present (1 iff the input was non-empty — matches `!text.empty()`)
//   then three length-prefixed fields, in order: algorithm, key, grants
//   ([len i64 LE][bytes]; len 0 if that key never appeared).
export "C" fn parse_sig(text: &[u8]) -> [u8] {
    let n: i64 = len(*text);

    let mut hasA: bool = false; let mut aA: i64 = 0; let mut aB: i64 = 0;
    let mut hasK: bool = false; let mut kA: i64 = 0; let mut kB: i64 = 0;
    let mut hasG: bool = false; let mut gA: i64 = 0; let mut gB: i64 = 0;

    let mut ls: i64 = 0;
    let mut i: i64 = 0;
    while i <= n {
        if i == n || (*text)[i] == '\n' {
            // projTrim the line [ls, i) -> [ts, te)
            let mut ts: i64 = ls;
            while ts < i && is_ws((*text)[ts]) { ts = ts + 1; }
            let mut te: i64 = i;
            while te > ts && is_ws((*text)[te - 1]) { te = te - 1; }
            // first ':'
            let mut cp: i64 = ts;
            let mut hasc: bool = false;
            while cp < te && hasc == false {
                if (*text)[cp] == ':' { hasc = true; 0 } else { cp = cp + 1; 0 };
            }
            if hasc {
                // key = projTrim [ts, cp); value = projTrim [cp+1, te)
                let mut ka: i64 = ts;
                while ka < cp && is_ws((*text)[ka]) { ka = ka + 1; }
                let mut kb: i64 = cp;
                while kb > ka && is_ws((*text)[kb - 1]) { kb = kb - 1; }
                let mut va: i64 = cp + 1;
                while va < te && is_ws((*text)[va]) { va = va + 1; }
                let mut vb: i64 = te;
                while vb > va && is_ws((*text)[vb - 1]) { vb = vb - 1; }
                if lit_eq(text, ka, kb, "algorithm") {
                    aA = va; aB = vb; hasA = true; 0
                } else {
                    if lit_eq(text, ka, kb, "key") {
                        kA = va; kB = vb; hasK = true; 0
                    } else {
                        if lit_eq(text, ka, kb, "grants") {
                            gA = va; gB = vb; hasG = true; 0
                        } else { 0 };
                        0
                    };
                    0
                };
                0
            } else { 0 };
            ls = i + 1;
            0
        } else { 0 };
        i = i + 1;
    }

    let mut out: Vec<u8> = vec_new();
    if n > 0 { push(&mut out, i64_to_u8(1)); 0 } else { push(&mut out, i64_to_u8(0)); 0 };
    if hasA { push_lenpref(&mut out, text, aA, aB); 0 } else { push_le8(&mut out, 0); 0 };
    if hasK { push_lenpref(&mut out, text, kA, kB); 0 } else { push_le8(&mut out, 0); 0 };
    if hasG { push_lenpref(&mut out, text, gA, gB); 0 } else { push_le8(&mut out, 0); 0 };
    vec_to_array(out)
}

// ---- project manifest reader ------------------------------------------------
//
// A faithful port of Project.h::loadProject's parsing. The manifest is real TOML;
// the IDE reads the flat `[section] key = value` fields and the `[[target]]`
// array-of-tables. Two behaviours must be replicated EXACTLY, and they differ:
//
//   * Flat fields were read via the Win32 profile API (GetPrivateProfileString),
//     which is CASE-INSENSITIVE for section + key, returns the FIRST match, and
//     applies no comment stripping (projUnq strips quotes afterward). Empirically
//     confirmed (scratchpad probe). -> emit_scalar / emit_array use lit_ieq.
//   * [[target]] blocks were hand-parsed (parseTargets), matching field keys
//     CASE-SENSITIVELY (`k == "name"`). -> emit_targets uses lit_eq.
//
// File I/O stays native (readUtf8); the host hands the bytes in and unpacks the
// record below into a SentinelProject, then applies the trivial post-processing
// (typeFromName / tierFromName / the sign=="true" test / single-target fallback).
//
// Record the host unpacks, in this exact order:
//   10 scalars, each  [found:1 byte][len i64 LE][bytes]  (projUnq'd; len 0 if absent):
//       project.name, project.version, project.type, project.entry, project.icon,
//       build.src, build.default_tier, signing.require, signing.trust, signing.sign
//   2 arrays, each a stream { byte 1, [len i64][bytes] }* then byte 0:
//       build.lib_paths, build.links
//   targets: a stream, per target { byte 1, name/entry/type each [len][bytes],
//       then a links stream { byte 1, [len][bytes] }* byte 0 }, ended by byte 0.

fn to_lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { i64_to_u8((c as i64) + 32) } else { c }
}

// Case-insensitive equality of text[a..b) and the (lowercase) literal `lit`.
// `lit` is borrowed (&[u8]) not moved: emit_scalar passes the same key/section param
// on every loop iteration, and a by-value [u8] would be moved out on the first.
fn lit_ieq(text: &[u8], a: i64, b: i64, lit: &[u8]) -> bool {
    let m: i64 = b - a;
    let ll: i64 = len(*lit);
    let mut ok: bool = m == ll;
    let mut i: i64 = 0;
    while ok && i < ll {
        ok = ok && (to_lower((*text)[a + i]) == (*lit)[i]);
        i = i + 1;
    }
    ok
}

// Is the trimmed line [ts,te) the header `[sect]` (single-bracket, case-insensitive)?
fn sect_eq(text: &[u8], ts: i64, te: i64, sect: &[u8]) -> bool {
    let mut ok: bool = false;
    if te - ts >= 2 && (*text)[ts] == '[' && (*text)[ts + 1] != '[' {
        let mut re: i64 = ts + 1;
        let mut hasr: bool = false;
        while re < te && hasr == false {
            if (*text)[re] == ']' { hasr = true; 0 } else { re = re + 1; 0 };
        }
        if hasr {
            let mut ia: i64 = ts + 1;
            while ia < re && is_ws((*text)[ia]) { ia = ia + 1; }
            let mut ib: i64 = re;
            while ib > ia && is_ws((*text)[ib - 1]) { ib = ib - 1; }
            ok = lit_ieq(text, ia, ib, sect);
            0
        } else { 0 };
        0
    } else { 0 };
    ok
}

// Emit a scalar field [found][lenpref], matching GetPrivateProfileString + projUnq:
// first case-insensitive key match inside the first matching section, value projUnq'd.
fn emit_scalar(out: &mut Vec<u8>, text: &[u8], n: i64, sect: &[u8], key: &[u8]) -> i64 {
    let mut inSect: bool = false;
    let mut found: bool = false;
    let mut va: i64 = 0; let mut vb: i64 = 0;
    let mut ls: i64 = 0; let mut i: i64 = 0;
    while i <= n && found == false {
        if i == n || (*text)[i] == '\n' {
            let mut ts: i64 = ls;
            while ts < i && is_ws((*text)[ts]) { ts = ts + 1; }
            let mut te: i64 = i;
            while te > ts && is_ws((*text)[te - 1]) { te = te - 1; }
            if ts < te && (*text)[ts] != '#' {
                if (*text)[ts] == '[' {
                    inSect = sect_eq(text, ts, te, sect); 0
                } else {
                    if inSect {
                        let mut eq: i64 = ts;
                        let mut haseq: bool = false;
                        while eq < te && haseq == false {
                            if (*text)[eq] == '=' { haseq = true; 0 } else { eq = eq + 1; 0 };
                        }
                        if haseq {
                            let mut ka: i64 = ts;
                            while ka < eq && is_ws((*text)[ka]) { ka = ka + 1; }
                            let mut kb: i64 = eq;
                            while kb > ka && is_ws((*text)[kb - 1]) { kb = kb - 1; }
                            if lit_ieq(text, ka, kb, key) {
                                let mut ua: i64 = eq + 1;
                                while ua < te && is_hsp((*text)[ua]) { ua = ua + 1; }
                                let mut ub: i64 = te;
                                while ub > ua && is_hsp_cr((*text)[ub - 1]) { ub = ub - 1; }
                                if ub - ua >= 2 && (*text)[ua] == '"' && (*text)[ub - 1] == '"' { ua = ua + 1; ub = ub - 1; 0 } else { 0 };
                                va = ua; vb = ub; found = true; 0
                            } else { 0 };
                            0
                        } else { 0 };
                        0
                    } else { 0 };
                    0
                };
                0
            } else { 0 };
            ls = i + 1; 0
        } else { 0 };
        i = i + 1;
    }
    if found { push(out, i64_to_u8(1)); push_lenpref(out, text, va, vb); 0 }
    else { push(out, i64_to_u8(0)); push_le8(out, 0); 0 };
    0
}

// Emit an array field as a { byte 1, lenpref }* stream ended by byte 0. The raw value
// (the whole `["a", "b"]`) is located like a scalar, then its quoted strings extracted
// (projArr) via emit_grants. Absent key -> empty stream (matches the "" default).
fn emit_array(out: &mut Vec<u8>, text: &[u8], n: i64, sect: &[u8], key: &[u8]) -> i64 {
    let mut inSect: bool = false;
    let mut found: bool = false;
    let mut va: i64 = 0; let mut vb: i64 = 0;
    let mut ls: i64 = 0; let mut i: i64 = 0;
    while i <= n && found == false {
        if i == n || (*text)[i] == '\n' {
            let mut ts: i64 = ls;
            while ts < i && is_ws((*text)[ts]) { ts = ts + 1; }
            let mut te: i64 = i;
            while te > ts && is_ws((*text)[te - 1]) { te = te - 1; }
            if ts < te && (*text)[ts] != '#' {
                if (*text)[ts] == '[' {
                    inSect = sect_eq(text, ts, te, sect); 0
                } else {
                    if inSect {
                        let mut eq: i64 = ts;
                        let mut haseq: bool = false;
                        while eq < te && haseq == false {
                            if (*text)[eq] == '=' { haseq = true; 0 } else { eq = eq + 1; 0 };
                        }
                        if haseq {
                            let mut ka: i64 = ts;
                            while ka < eq && is_ws((*text)[ka]) { ka = ka + 1; }
                            let mut kb: i64 = eq;
                            while kb > ka && is_ws((*text)[kb - 1]) { kb = kb - 1; }
                            if lit_ieq(text, ka, kb, key) { va = eq + 1; vb = te; found = true; 0 } else { 0 };
                            0
                        } else { 0 };
                        0
                    } else { 0 };
                    0
                };
                0
            } else { 0 };
            ls = i + 1; 0
        } else { 0 };
        i = i + 1;
    }
    if found { emit_grants(out, text, va, vb); 0 } else { 0 };
    push(out, i64_to_u8(0));
    0
}

// Emit one target record (name/entry/type + a links stream).
fn flush_target(out: &mut Vec<u8>, text: &[u8],
                hasN: bool, nA: i64, nB: i64,
                hasE: bool, eA: i64, eB: i64,
                hasT: bool, tA: i64, tB: i64,
                hasL: bool, lA: i64, lB: i64) -> i64 {
    push(out, i64_to_u8(1));
    if hasN { push_lenpref(out, text, nA, nB); 0 } else { push_le8(out, 0); 0 };
    if hasE { push_lenpref(out, text, eA, eB); 0 } else { push_le8(out, 0); 0 };
    if hasT { push_lenpref(out, text, tA, tB); 0 } else { push_le8(out, 0); 0 };
    if hasL { emit_grants(out, text, lA, lB); 0 } else { 0 };
    push(out, i64_to_u8(0));   // links terminator
    0
}

// Emit the [[target]] stream. parseTargets: `[[...target...]]` opens a block (loose
// contains-match), field keys matched CASE-SENSITIVELY, name/entry/type projUnq'd,
// links from the raw value; a normal `[section]` closes the block.
fn emit_targets(out: &mut Vec<u8>, text: &[u8], n: i64) -> i64 {
    let mut have: bool = false;
    let mut hasN: bool = false; let mut nA: i64 = 0; let mut nB: i64 = 0;
    let mut hasE: bool = false; let mut eA: i64 = 0; let mut eB: i64 = 0;
    let mut hasT: bool = false; let mut tA: i64 = 0; let mut tB: i64 = 0;
    let mut hasL: bool = false; let mut lA: i64 = 0; let mut lB: i64 = 0;

    let mut ls: i64 = 0; let mut i: i64 = 0;
    while i <= n {
        if i == n || (*text)[i] == '\n' {
            let mut ts: i64 = ls;
            while ts < i && is_ws((*text)[ts]) { ts = ts + 1; }
            let mut te: i64 = i;
            while te > ts && is_ws((*text)[te - 1]) { te = te - 1; }
            if ts < te && (*text)[ts] != '#' {
                if te - ts >= 2 && (*text)[ts] == '[' && (*text)[ts + 1] == '[' {
                    if have { flush_target(out, text, hasN, nA, nB, hasE, eA, eB, hasT, tA, tB, hasL, lA, lB); 0 } else { 0 };
                    if range_has(text, ts, te, "target") {
                        have = true; hasN = false; hasE = false; hasT = false; hasL = false; 0
                    } else { have = false; 0 };
                    0
                } else {
                    if (*text)[ts] == '[' {
                        if have { flush_target(out, text, hasN, nA, nB, hasE, eA, eB, hasT, tA, tB, hasL, lA, lB); 0 } else { 0 };
                        have = false; 0
                    } else {
                        if have {
                            let mut eq: i64 = ts;
                            let mut haseq: bool = false;
                            while eq < te && haseq == false {
                                if (*text)[eq] == '=' { haseq = true; 0 } else { eq = eq + 1; 0 };
                            }
                            if haseq {
                                let mut ka: i64 = ts;
                                while ka < eq && is_ws((*text)[ka]) { ka = ka + 1; }
                                let mut kb: i64 = eq;
                                while kb > ka && is_ws((*text)[kb - 1]) { kb = kb - 1; }
                                let mut ua: i64 = eq + 1;
                                while ua < te && is_hsp((*text)[ua]) { ua = ua + 1; }
                                let mut ub: i64 = te;
                                while ub > ua && is_hsp_cr((*text)[ub - 1]) { ub = ub - 1; }
                                if ub - ua >= 2 && (*text)[ua] == '"' && (*text)[ub - 1] == '"' { ua = ua + 1; ub = ub - 1; 0 } else { 0 };
                                if lit_eq(text, ka, kb, "name") {
                                    nA = ua; nB = ub; hasN = true; 0
                                } else {
                                    if lit_eq(text, ka, kb, "entry") {
                                        eA = ua; eB = ub; hasE = true; 0
                                    } else {
                                        if lit_eq(text, ka, kb, "type") {
                                            tA = ua; tB = ub; hasT = true; 0
                                        } else {
                                            if lit_eq(text, ka, kb, "links") { lA = eq + 1; lB = te; hasL = true; 0 } else { 0 };
                                            0
                                        };
                                        0
                                    };
                                    0
                                };
                                0
                            } else { 0 };
                            0
                        } else { 0 };
                        0
                    };
                    0
                };
                0
            } else { 0 };
            ls = i + 1; 0
        } else { 0 };
        i = i + 1;
    }
    if have { flush_target(out, text, hasN, nA, nB, hasE, eA, eB, hasT, tA, tB, hasL, lA, lB); 0 } else { 0 };
    push(out, i64_to_u8(0));   // end of targets
    0
}

export "C" fn parse_manifest(text: &[u8]) -> [u8] {
    let n: i64 = len(*text);
    let mut out: Vec<u8> = vec_new();
    // Literals bound to locals so they can be BORROWED (&x): Sentinel forbids `&"lit"`
    // (can't borrow a temporary), and a by-value [u8] param would be moved out on the
    // first loop iteration inside the emitters. Section names are borrowed repeatedly,
    // which is fine — shared borrows are copyable.
    let s_project: [u8] = "project";
    let s_build: [u8] = "build";
    let s_signing: [u8] = "signing";
    let k_name: [u8] = "name";
    let k_version: [u8] = "version";
    let k_type: [u8] = "type";
    let k_entry: [u8] = "entry";
    let k_icon: [u8] = "icon";
    let k_src: [u8] = "src";
    let k_tier: [u8] = "default_tier";
    let k_require: [u8] = "require";
    let k_trust: [u8] = "trust";
    let k_sign: [u8] = "sign";
    let k_libpaths: [u8] = "lib_paths";
    let k_links: [u8] = "links";
    emit_scalar(&mut out, text, n, &s_project, &k_name);
    emit_scalar(&mut out, text, n, &s_project, &k_version);
    emit_scalar(&mut out, text, n, &s_project, &k_type);
    emit_scalar(&mut out, text, n, &s_project, &k_entry);
    emit_scalar(&mut out, text, n, &s_project, &k_icon);
    emit_scalar(&mut out, text, n, &s_build, &k_src);
    emit_scalar(&mut out, text, n, &s_build, &k_tier);
    emit_scalar(&mut out, text, n, &s_signing, &k_require);
    emit_scalar(&mut out, text, n, &s_signing, &k_trust);
    emit_scalar(&mut out, text, n, &s_signing, &k_sign);
    emit_array(&mut out, text, n, &s_build, &k_libpaths);
    emit_array(&mut out, text, n, &s_build, &k_links);
    emit_targets(&mut out, text, n);
    vec_to_array(out)
}

// ---- project manifest WRITER ------------------------------------------------
//
// A faithful port of Project.h::saveProject — the last file-touching path that was
// still C++. Pure bytes in, bytes out: `text` is the manifest as it stands on disk
// (empty if there is none) and `model` is the managed values ALREADY rendered as
// TOML value text by the host, so quoting and array formatting stay exactly where
// tomlStr/tomlArr put them. The return is the COMPLETE new manifest; the host
// writes it. Sentinel does no file I/O here, same as the four readers above.
//
// The writer is surgical on purpose: it rewrites only the VALUES of the keys the
// IDE manages and leaves everything else — comments, blank lines, the file's own
// key alignment, unmodeled keys like `icon`/`authors` — byte for byte as it found
// them. (TOML forbids duplicate section headers, so a missing managed key is
// inserted INSIDE its existing section rather than appended as a second block.)
//
// `model` encoding, fixed order, host-produced. Every value is an 8-byte
// little-endian length followed by that many bytes — the same length-prefix idiom
// push_lenpref writes on the read side. Values arrive fully rendered, e.g. the six
// bytes `"demo"` INCLUDING its quotes, or `[]`:
//     0 name    1 version    2 type   3 entry          -> section [project]
//     4 src     5 lib_paths  6 links  7 default_tier   -> section [build]
//     8 require 9 trust     10 sign                    -> section [signing]
//   then an 8-byte LE target count, then per target: name, entry, type, links.
//
// The algorithm, mirroring saveProject step for step:
//   1. Split on '\n'; a trailing '\r' is dropped. The final segment is a line only
//      if it is non-empty — and it KEEPS its '\r' (the C++ pops the CR only in the
//      '\n' branch), so a CR-terminated last line round-trips unchanged.
//   2. A line whose TRIMMED form starts with '[' opens a section named by the
//      trimmed text between '[' and the FIRST ']', lowercased. "[[target]]" therefore
//      names the section "[target" — the leading bracket is retained. That is
//      load-bearing, not a bug to fix: the target pass keys off exactly that name.
//   3. Rewrite pass: in a managed section, a line that is not blank/comment/header
//      is split at its FIRST '='; the key (trimmed) is matched against the first
//      not-yet-written managed entry of that section, and the line becomes
//      line[0..eq] + "= " + value — everything up to and including the '=' survives,
//      and the file's alignment survives with it. Only the FIRST match wins (the
//      C++ breaks out of the loop), so a duplicate key line later is left untouched.
//      ASYMMETRY, preserved deliberately: section names compare CASE-INSENSITIVELY
//      (the C++ lowercases them), key names CASE-SENSITIVELY. `Name` is not `name`.
//   4. Any managed entry still unwritten is appended at the END of its section's
//      lines — after that section's trailing blank lines, as in the C++ — in the
//      order project, build, signing. A section that does not exist at all is
//      appended at the very end as a blank line, then "[<section>]", then its keys.
//   5. [[target]] blocks are matched to the model's targets BY ORDER; only EXISTING
//      name/entry/type/links lines are rewritten, NEVER inserted, so per-target
//      comments and unmodeled keys survive. The index advances for every "[target"
//      section, including ones past the end of the model's list (emitted untouched).
//   6. Every line is emitted with CRLF; then, while the output is at least 4 bytes
//      and ends with two CRLFs, the last 2 bytes are dropped — collapsing trailing
//      blank lines to a single newline.
//
// SHAPE NOTES — why this does not look like the C++. Sentinel has no Vec<[u8]>, so
// there is no vector-of-lines to build and mutate; everything works on OFFSETS into
// `text` and appends to one Vec<u8>. Insertion has to know the FINAL set of written
// entries before the first line is emitted, so the line walk runs three times —
// rewrite_mask (which entries get consumed), sect_last_line (where a section's last
// line is), then the emit — which is the same "re-walk per question" shape
// emit_scalar/emit_array already use. The `written` flags are an 11-bit mask packed
// into an i64, there being no mutable bool array.
//
// Section ids used throughout: 1 = project, 2 = build, 3 = signing, 4 = "[target",
// 0 = anything else, including the preamble before the first header (which the C++
// models as a section whose name is "" and which no managed key can ever match).

// Read 8 little-endian bytes at `off` as an i64 (the inverse of push_le8). Built from
// the TOP byte down, which keeps the accumulator small for well-formed input but does
// NOT make overflow impossible: a length whose top byte is >= 0x80 still overflows i64
// and comes out negative. That is caught by the `off >= 0` half of the guard below, not
// by the accumulation order — do not read this as an overflow proof.
//
// The bound is written `off <= len - 8`, never `off + 8 <= len`: the addition form
// WRAPS. An `off` in [0x7FFFFFFFFFFFFFF0, 0x7FFFFFFFFFFFFFF7] makes `off + 8` negative,
// so the comparison passes while `off >= 0` also passes, and the index below runs at
// i64::MAX — which is not a wrong answer but a dead process, since a bounds violation
// inside a Sentinel export terminates immediately and __try/__except cannot recover it
// (R2). Measured: the addition form aborted with 0xC0000409 on exactly that window.
// Unreachable from a manifest — every prefix here is a host-computed byte count — so
// this is defence in depth against a future host-encoder bug.
fn rd_le8(m: &[u8], off: i64) -> i64 {
    let mut v: i64 = 0;
    if off >= 0 && off <= len(*m) - 8 {
        let mut i: i64 = 7;
        while i >= 0 {
            v = v * 256 + ((*m)[off + i] as i64);
            i = i - 1;
        }
        0
    } else { 0 };
    v
}

// Offset just past the length-prefixed value that starts at `off`.
fn skip_str(m: &[u8], off: i64) -> i64 {
    off + 8 + rd_le8(m, off)
}

// Offset of the n'th length-prefixed value counting from `base`.
fn skip_n(m: &[u8], base: i64, n: i64) -> i64 {
    let mut o: i64 = base;
    let mut i: i64 = 0;
    while i < n {
        o = skip_str(m, o);
        i = i + 1;
    }
    o
}

// Append the bytes of the length-prefixed value at `off` (the prefix itself is not
// emitted — the value is already rendered TOML text).
fn push_val(out: &mut Vec<u8>, m: &[u8], off: i64) -> i64 {
    let mn: i64 = len(*m);
    let vl: i64 = rd_le8(m, off);
    let mut i: i64 = 0;
    while i < vl && off + 8 + i < mn {
        push(out, (*m)[off + 8 + i]);
        i = i + 1;
    }
    0
}

// Append text[a..b) verbatim (push_lenpref without the length prefix).
fn push_bytes(out: &mut Vec<u8>, text: &[u8], a: i64, b: i64) -> i64 {
    let mut i: i64 = a;
    while i < b {
        push(out, (*text)[i]);
        i = i + 1;
    }
    0
}

// Append a literal. By-value `[u8]`, so a call site can hand it a fresh string
// literal directly — `&"lit"` is illegal (no borrowing a temporary), and nothing
// here reuses one literal across an enclosing loop, which is what would move it.
fn push_lit(out: &mut Vec<u8>, lit: [u8]) -> i64 {
    let ll: i64 = len(lit);
    let mut i: i64 = 0;
    while i < ll {
        push(out, lit[i]);
        i = i + 1;
    }
    0
}

// The `written` flags of saveProject's KV table, as bits of an i64: Sentinel has no
// mutable bool array, and 11 entries fit comfortably in one integer.
fn pow2(e: i64) -> i64 {
    let mut p: i64 = 1;
    let mut i: i64 = 0;
    while i < e {
        p = p * 2;
        i = i + 1;
    }
    p
}
fn bit_get(mask: i64, e: i64) -> bool {
    let q: i64 = mask / pow2(e);
    (q - (q / 2) * 2) == 1          // no `%` operator — q mod 2
}
fn bit_set(mask: i64, e: i64) -> i64 {
    if bit_get(mask, e) { mask } else { mask + pow2(e) }
}

// Section id of the header line trimmed to [ts,te) (its first byte is '['). The name
// is the trimmed text between '[' and the FIRST ']', compared case-insensitively
// (the C++ projLower's it). No ']' at all -> the C++ name is "", i.e. id 0. Note
// "[target": sect_eq above REJECTS a double bracket, this one must not — the
// writer's whole [[target]] pass keys off that bracket-retaining name.
fn sec_id(text: &[u8], ts: i64, te: i64) -> i64 {
    let mut id: i64 = 0;
    let mut re: i64 = ts;
    let mut hasr: bool = false;
    while re < te && hasr == false {
        if (*text)[re] == ']' { hasr = true; 0 } else { re = re + 1; 0 };
    }
    if hasr {
        let mut ia: i64 = ts + 1;
        while ia < re && is_ws((*text)[ia]) { ia = ia + 1; }
        let mut ib: i64 = re;
        while ib > ia && is_ws((*text)[ib - 1]) { ib = ib - 1; }
        let s_p: [u8] = "project";
        let s_b: [u8] = "build";
        let s_g: [u8] = "signing";
        let s_t: [u8] = "[target";
        if lit_ieq(text, ia, ib, &s_p) { id = 1; 0 } else { 0 };
        if lit_ieq(text, ia, ib, &s_b) { id = 2; 0 } else { 0 };
        if lit_ieq(text, ia, ib, &s_g) { id = 3; 0 } else { 0 };
        if lit_ieq(text, ia, ib, &s_t) { id = 4; 0 } else { 0 };
        0
    } else { 0 };
    id
}

// Which section managed entry `e` belongs to (the KV table's fixed layout).
fn ent_sec(e: i64) -> i64 {
    if e < 4 { 1 } else { if e < 8 { 2 } else { 3 } }
}

// Is text[a..b) entry `e`'s key? CASE-SENSITIVE, like the C++ `e.key == key` and
// unlike the section test above — `Name` is not the managed `name`.
fn ent_key_eq(e: i64, text: &[u8], a: i64, b: i64) -> bool {
    let mut ok: bool = false;
    if e == 0  { ok = lit_eq(text, a, b, "name"); 0 } else { 0 };
    if e == 1  { ok = lit_eq(text, a, b, "version"); 0 } else { 0 };
    if e == 2  { ok = lit_eq(text, a, b, "type"); 0 } else { 0 };
    if e == 3  { ok = lit_eq(text, a, b, "entry"); 0 } else { 0 };
    if e == 4  { ok = lit_eq(text, a, b, "src"); 0 } else { 0 };
    if e == 5  { ok = lit_eq(text, a, b, "lib_paths"); 0 } else { 0 };
    if e == 6  { ok = lit_eq(text, a, b, "links"); 0 } else { 0 };
    if e == 7  { ok = lit_eq(text, a, b, "default_tier"); 0 } else { 0 };
    if e == 8  { ok = lit_eq(text, a, b, "require"); 0 } else { 0 };
    if e == 9  { ok = lit_eq(text, a, b, "trust"); 0 } else { 0 };
    if e == 10 { ok = lit_eq(text, a, b, "sign"); 0 } else { 0 };
    ok
}

fn push_ent_key(out: &mut Vec<u8>, e: i64) -> i64 {
    if e == 0  { push_lit(out, "name"); 0 } else { 0 };
    if e == 1  { push_lit(out, "version"); 0 } else { 0 };
    if e == 2  { push_lit(out, "type"); 0 } else { 0 };
    if e == 3  { push_lit(out, "entry"); 0 } else { 0 };
    if e == 4  { push_lit(out, "src"); 0 } else { 0 };
    if e == 5  { push_lit(out, "lib_paths"); 0 } else { 0 };
    if e == 6  { push_lit(out, "links"); 0 } else { 0 };
    if e == 7  { push_lit(out, "default_tier"); 0 } else { 0 };
    if e == 8  { push_lit(out, "require"); 0 } else { 0 };
    if e == 9  { push_lit(out, "trust"); 0 } else { 0 };
    if e == 10 { push_lit(out, "sign"); 0 } else { 0 };
    0
}

fn push_sec_name(out: &mut Vec<u8>, sid: i64) -> i64 {
    if sid == 1 { push_lit(out, "project"); 0 } else { 0 };
    if sid == 2 { push_lit(out, "build"); 0 } else { 0 };
    if sid == 3 { push_lit(out, "signing"); 0 } else { 0 };
    0
}

// The first not-yet-written managed entry in section `sid` whose key is text[a..b),
// or -1. "First wins" is the C++ `break`: a second line with the same key is left
// alone, because by then the entry is already marked written.
fn find_entry(mask: i64, sid: i64, text: &[u8], a: i64, b: i64) -> i64 {
    let mut hit: i64 = 0 - 1;
    let mut e: i64 = 0;
    while e < 11 && hit < 0 {
        if bit_get(mask, e) == false && ent_sec(e) == sid && ent_key_eq(e, text, a, b) {
            hit = e; 0
        } else { 0 };
        e = e + 1;
    }
    hit
}

// The per-target field index for key text[a..b): 0 name, 1 entry, 2 type, 3 links,
// -1 for anything else (which the C++ `continue`s past, leaving the line alone).
fn tgt_field(text: &[u8], a: i64, b: i64) -> i64 {
    let mut f: i64 = 0 - 1;
    if lit_eq(text, a, b, "name")  { f = 0; 0 } else { 0 };
    if lit_eq(text, a, b, "entry") { f = 1; 0 } else { 0 };
    if lit_eq(text, a, b, "type")  { f = 2; 0 } else { 0 };
    if lit_eq(text, a, b, "links") { f = 3; 0 } else { 0 };
    f
}

// Walk 1: replay the rewrite pass for its FLAGS only. The emit pass has to know
// which managed entries an existing line will consume before it writes its first
// byte, because insertion happens mid-file (at the end of a section) and must skip
// whatever the rewrite already handled.
fn rewrite_mask(text: &[u8], n: i64) -> i64 {
    let mut mask: i64 = 0;
    let mut sid: i64 = 0;
    let mut ls: i64 = 0;
    let mut i: i64 = 0;
    while i <= n {
        if i == n || (*text)[i] == '\n' {
            let la: i64 = ls;
            let mut lb: i64 = i;
            let mut isline: bool = true;
            if i == n {
                isline = lb > la;      // trailing segment: a line only if non-empty
                0
            } else {
                if lb > la && (*text)[lb - 1] == '\r' { lb = lb - 1; 0 } else { 0 };
                0
            };
            if isline {
                let mut ts: i64 = la;
                while ts < lb && is_ws((*text)[ts]) { ts = ts + 1; }
                let mut te: i64 = lb;
                while te > ts && is_ws((*text)[te - 1]) { te = te - 1; }
                if ts < te && (*text)[ts] == '[' {
                    sid = sec_id(text, ts, te); 0
                } else {
                    if ts < te && (*text)[ts] != '#' && sid >= 1 && sid <= 3 {
                        let mut eq: i64 = la;
                        let mut haseq: bool = false;
                        while eq < lb && haseq == false {
                            if (*text)[eq] == '=' { haseq = true; 0 } else { eq = eq + 1; 0 };
                        }
                        if haseq {
                            let mut ka: i64 = la;
                            while ka < eq && is_ws((*text)[ka]) { ka = ka + 1; }
                            let mut kb: i64 = eq;
                            while kb > ka && is_ws((*text)[kb - 1]) { kb = kb - 1; }
                            let me: i64 = find_entry(mask, sid, text, ka, kb);
                            if me >= 0 { mask = bit_set(mask, me); 0 } else { 0 };
                            0
                        } else { 0 };
                        0
                    } else { 0 };
                    0
                };
                0
            } else { 0 };
            ls = i + 1;
            0
        } else { 0 };
        i = i + 1;
    }
    mask
}

// Walk 2: the index of the LAST line of the FIRST section with id `want`, or -1 if
// there is none. That is where saveProject inserts missing keys (it appends to the
// section's line vector, hence after any trailing blank lines the section owns);
// -1 doubles as the "no such section — append a fresh one at the end" signal.
fn sect_last_line(text: &[u8], n: i64, want: i64) -> i64 {
    let mut seen: bool = false;
    let mut active: bool = false;
    let mut last: i64 = 0 - 1;
    let mut li: i64 = 0;
    let mut ls: i64 = 0;
    let mut i: i64 = 0;
    while i <= n {
        if i == n || (*text)[i] == '\n' {
            let la: i64 = ls;
            let mut lb: i64 = i;
            let mut isline: bool = true;
            if i == n {
                isline = lb > la;
                0
            } else {
                if lb > la && (*text)[lb - 1] == '\r' { lb = lb - 1; 0 } else { 0 };
                0
            };
            if isline {
                let mut ts: i64 = la;
                while ts < lb && is_ws((*text)[ts]) { ts = ts + 1; }
                let mut te: i64 = lb;
                while te > ts && is_ws((*text)[te - 1]) { te = te - 1; }
                if ts < te && (*text)[ts] == '[' {
                    let hid: i64 = sec_id(text, ts, te);
                    if hid == want && seen == false {
                        seen = true; active = true; 0
                    } else { active = false; 0 };
                    0
                } else { 0 };
                // The header is lines[0] of its own section, so it counts too: a
                // section that is nothing but its header still takes the insert.
                if active { last = li; 0 } else { 0 };
                li = li + 1;
                0
            } else { 0 };
            ls = i + 1;
            0
        } else { 0 };
        i = i + 1;
    }
    last
}

// Does section `sid` still owe any managed key? (The C++ skips an empty `missing`
// list, which only matters for the "create the section" branch.)
fn sect_missing_any(mask: i64, sid: i64) -> bool {
    let mut any: bool = false;
    let mut e: i64 = 0;
    while e < 11 {
        if bit_get(mask, e) == false && ent_sec(e) == sid { any = true; 0 } else { 0 };
        e = e + 1;
    }
    any
}

// Append `key = value` lines for every entry of `sid` the rewrite pass did not
// consume, in the KV table's fixed order.
fn emit_missing(out: &mut Vec<u8>, m: &[u8], mask: i64, sid: i64) -> i64 {
    let mut e: i64 = 0;
    while e < 11 {
        if bit_get(mask, e) == false && ent_sec(e) == sid {
            push_ent_key(out, e);
            push_lit(out, " = ");
            push_val(out, m, skip_n(m, 0, e));
            push_lit(out, "\r\n");
            0
        } else { 0 };
        e = e + 1;
    }
    0
}

// A section the manifest never declared: blank line, header, then its keys — the
// C++ pushes Section{ sname, { "", "[sname]" } } and appends the missing keys to it.
fn append_section(out: &mut Vec<u8>, m: &[u8], mask: i64, sid: i64) -> i64 {
    if sect_missing_any(mask, sid) {
        push_lit(out, "\r\n");
        push_lit(out, "[");
        push_sec_name(out, sid);
        push_lit(out, "]");
        push_lit(out, "\r\n");
        emit_missing(out, m, mask, sid);
        0
    } else { 0 };
    0
}

export "C" fn save_manifest(text: &[u8], model: &[u8]) -> [u8] {
    let n: i64 = len(*text);

    // Model layout: 11 scalars, then the target count, then 4 values per target.
    let tbase: i64 = skip_n(model, 0, 11);
    let tcount: i64 = rd_le8(model, tbase);
    let tfirst: i64 = tbase + 8;

    // Everything the emit walk has to know up front (see SHAPE NOTES).
    let final_mask: i64 = rewrite_mask(text, n);
    let last1: i64 = sect_last_line(text, n, 1);
    let last2: i64 = sect_last_line(text, n, 2);
    let last3: i64 = sect_last_line(text, n, 3);

    let mut out: Vec<u8> = vec_new();
    let mut mask: i64 = 0;          // replayed, so "first match wins" lands identically
    let mut sid: i64 = 0;
    let mut ti: i64 = 0 - 1;        // model index of the [[target]] block we are inside
    let mut tnext: i64 = 0;
    let mut li: i64 = 0;
    let mut ls: i64 = 0;
    let mut i: i64 = 0;
    while i <= n {
        if i == n || (*text)[i] == '\n' {
            let la: i64 = ls;
            let mut lb: i64 = i;
            let mut isline: bool = true;
            if i == n {
                isline = lb > la;
                0
            } else {
                if lb > la && (*text)[lb - 1] == '\r' { lb = lb - 1; 0 } else { 0 };
                0
            };
            if isline {
                let mut ts: i64 = la;
                while ts < lb && is_ws((*text)[ts]) { ts = ts + 1; }
                let mut te: i64 = lb;
                while te > ts && is_ws((*text)[te - 1]) { te = te - 1; }
                let mut done: bool = false;     // true once a rewritten line was emitted
                if ts < te && (*text)[ts] == '[' {
                    sid = sec_id(text, ts, te);
                    // The index advances for EVERY "[target" block, including ones
                    // the model has no target for (those are emitted untouched).
                    if sid == 4 { ti = tnext; tnext = tnext + 1; 0 } else { 0 };
                    0
                } else {
                    if ts < te && (*text)[ts] != '#' {
                        let mut eq: i64 = la;
                        let mut haseq: bool = false;
                        while eq < lb && haseq == false {
                            if (*text)[eq] == '=' { haseq = true; 0 } else { eq = eq + 1; 0 };
                        }
                        if haseq {
                            let mut ka: i64 = la;
                            while ka < eq && is_ws((*text)[ka]) { ka = ka + 1; }
                            let mut kb: i64 = eq;
                            while kb > ka && is_ws((*text)[kb - 1]) { kb = kb - 1; }
                            if sid >= 1 && sid <= 3 {
                                let me: i64 = find_entry(mask, sid, text, ka, kb);
                                if me >= 0 {
                                    mask = bit_set(mask, me);
                                    push_bytes(&mut out, text, la, eq + 1);   // through the '='
                                    push_lit(&mut out, " ");
                                    push_val(&mut out, model, skip_n(model, 0, me));
                                    done = true;
                                    0
                                } else { 0 };
                                0
                            } else {
                                if sid == 4 && ti >= 0 && ti < tcount {
                                    let f: i64 = tgt_field(text, ka, kb);
                                    if f >= 0 {
                                        push_bytes(&mut out, text, la, eq + 1);
                                        push_lit(&mut out, " ");
                                        push_val(&mut out, model, skip_n(model, tfirst, ti * 4 + f));
                                        done = true;
                                        0
                                    } else { 0 };
                                    0
                                } else { 0 };
                                0
                            };
                            0
                        } else { 0 };
                        0
                    } else { 0 };
                    0
                };
                if done { 0 } else { push_bytes(&mut out, text, la, lb); 0 };
                push_lit(&mut out, "\r\n");
                // Insertions land at the end of their section's own lines.
                if li == last1 { emit_missing(&mut out, model, final_mask, 1); 0 } else { 0 };
                if li == last2 { emit_missing(&mut out, model, final_mask, 2); 0 } else { 0 };
                if li == last3 { emit_missing(&mut out, model, final_mask, 3); 0 } else { 0 };
                li = li + 1;
                0
            } else { 0 };
            ls = i + 1;
            0
        } else { 0 };
        i = i + 1;
    }

    // Sections the manifest never had, appended at the very end in KV order.
    if last1 < 0 { append_section(&mut out, model, final_mask, 1); 0 } else { 0 };
    if last2 < 0 { append_section(&mut out, model, final_mask, 2); 0 } else { 0 };
    if last3 < 0 { append_section(&mut out, model, final_mask, 3); 0 } else { 0 };

    // Collapse trailing blank lines to one newline. The C++ erases the last 2 bytes
    // in place; with nothing to truncate a Vec here, the keep-length is computed
    // first and the prefix copied out — same bytes, one extra pass.
    let total: i64 = len(out);
    let mut keep: i64 = total;
    while keep >= 4
        && out[keep - 1] == '\n' && out[keep - 2] == '\r'
        && out[keep - 3] == '\n' && out[keep - 4] == '\r' {
        keep = keep - 2;
    }
    let mut fin: Vec<u8> = vec_new();
    let mut z: i64 = 0;
    while z < keep {
        push(&mut fin, out[z]);
        z = z + 1;
    }
    vec_to_array(fin)
}

// ---- appcast reader (the update feed) ---------------------------------------
//
// The last parser that was still C++, and the only one whose bytes arrive off the
// NETWORK: Updater.cpp fetches the feed over deliberately unauthenticated HTTPS (it
// is public raw.githubusercontent.com; the trust anchor is the Ed25519 signature
// WinSparkle checks on the DOWNLOAD, not the transport — see kAppcastUrl). So this
// is the one parser whose input an attacker, a captive portal or a corrupt CDN can
// choose, and what it decides is whether the IDE offers an update at all.
//
// It replaces three C++ functions in ONE crossing — the check runs hourly and on a
// menu click, so a single FFI call is free and it moves the most C++:
//   appcastVersion  — find sparkle:version="…" in the feed
//   parseVersion    — split "a.b.c.d" into components
//   versionIsNewer  — compare it against ours
// plus the validation step the C++ never had at all.
//
// TWO DEFECTS IN THAT C++ CLOSE BY CONSTRUCTION HERE.
//
//  1. UNBOUNDED SIGNED OVERFLOW. `out[i] = out[i] * 10 + (*v - '0')` accumulated into
//     an `int` over however many digits the feed supplied. sparkle:version=
//     "99999999999999" is undefined behaviour and in practice wraps — so a LOWER
//     version could compare as newer, or a real release could be suppressed, and this
//     is the arithmetic that decides whether to offer one. Here a component is capped
//     at 9 digits (<= 999_999_999, four orders of magnitude inside i64), and a
//     component that exceeds the cap does not wrap and does not saturate: it makes the
//     WHOLE version invalid (see ver_valid).
//
//  2. NO VALIDATION. appcastVersion returned whatever sat between the quotes — any
//     bytes at all, up to the ~256 KB fetch cap — and the host then showed it in the
//     offer dialog, logged it, and on "Skip this version" PERSISTED IT into
//     settings.ini. Here the bytes come back only when they are a well-formed version,
//     so unvalidated feed content cannot reach a dialog, a log line or the ini file.
//
// FIRST MATCH, NOT HIGHEST — deliberate, and the cross-check pins the choice. Our feed
// carries exactly one <item> (scripts\make-appcast.ps1 emits one), so the two rules
// agree today and first-match is what shipped. It is also not the weaker rule against
// a hostile feed: taking the highest would let any entry anywhere in a 256 KB body
// dictate what we offer, where first-match bounds that to the first one. And nothing
// here is the security decision — the only question answered is whether to OFFER;
// WinSparkle re-reads the feed itself, downloads, and refuses anything that does not
// verify against the compiled-in public key. A rule that diverged from WinSparkle's
// own would only mean offering updates it then declines to install.
//
// Result record the host unpacks:
//   byte 0: found  — sparkle:version="…" located, opening AND closing quote
//   byte 1: valid  — ... and the text between them is a well-formed version
//   byte 2: newer  — ... and it is strictly newer than `mine`
//   then [len i64 LE][version bytes] — len 0 unless `valid`.
// The flags nest: newer implies valid implies found. Anything that cannot be parsed is
// NOT an update, which is the fail-closed half of defect 2.

// Index of `lit` in text[from..n), or -1. (C++ std::string::find.)
fn find_lit(text: &[u8], from: i64, n: i64, lit: &[u8]) -> i64 {
    let ll: i64 = len(*lit);
    let mut at: i64 = 0 - 1;
    let mut i: i64 = from;
    while i + ll <= n && at < 0 {
        let mut m: bool = true;
        let mut j: i64 = 0;
        while m && j < ll {
            m = m && ((*text)[i + j] == (*lit)[j]);
            j = j + 1;
        }
        if m { at = i; 0 } else { i = i + 1; 0 };
    }
    at
}

// THE VERSION GRAMMAR, and the only one accepted:
//     comp ( '.' comp ){0,3}          comp = 1..9 digits
// One to four components, every one non-empty, digits only, nothing else: no leading
// or trailing dot, no spaces, no 'v', no build metadata, no empty string.
//
// 9 DIGITS PER COMPONENT IS THE OVERFLOW BOUND. 999_999_999 * 10 + 9 still sits eleven
// digits inside i64, so ver_comp's accumulate cannot overflow for any accepted input.
// It also caps the whole string at 4*9+3 = 39 bytes, which is the "bounded length"
// half of the validation — a 256 KB feed cannot hand us a 256 KB "version".
//
// AN OVER-LONG COMPONENT REJECTS THE WHOLE VERSION. It is not saturated and not
// truncated: both of those invent a number the feed never stated, and a wrong number
// here either offers a downgrade or hides a real release. Refusing is the only answer
// that cannot be wrong in the dangerous direction — a version that cannot be parsed is
// simply not an update.
//
// MORE THAN FOUR COMPONENTS IS ALSO A REJECTION. The C++ read four and silently
// ignored the rest, so "1.2.3.4.5" and "1.2.3.4" compared EQUAL. We publish
// `^\d+\.\d+\.\d+\.\d+$` (make-appcast.ps1 enforces it before writing the feed), so
// refusing a fifth component can never suppress a real update — and comparing two
// versions while ignoring part of one of them is not a comparison.
fn ver_valid(text: &[u8], a: i64, b: i64) -> bool {
    let m: i64 = b - a;
    let mut ok: bool = m >= 1 && m <= 39;
    let mut dots: i64 = 0;
    let mut digits: i64 = 0;
    let mut i: i64 = a;
    while ok && i < b {
        let c: u8 = (*text)[i];
        if c == '.' {
            if digits == 0 { ok = false; 0 } else { 0 };      // empty component
            dots = dots + 1;
            if dots > 3 { ok = false; 0 } else { 0 };          // 5th component
            digits = 0;
            0
        } else {
            if is_digit(c) {
                digits = digits + 1;
                if digits > 9 { ok = false; 0 } else { 0 };    // the overflow bound
                0
            } else {
                ok = false;                                    // not a digit or a dot
                0
            };
            0
        };
        i = i + 1;
    }
    ok && digits > 0                                           // trailing '.' -> empty
}

// Value of component `k` (0-based) of text[a..b). Missing trailing components read as
// 0, so "0.1.6" == "0.1.6.0" — existing behaviour, and the cross-check holds it.
//
// PRECONDITION: ver_valid(text, a, b) already said yes, so the `digits < 9` guard is
// unreachable. It is written anyway so that this function cannot overflow for ANY
// input, which is exactly what Updater.cpp::parseVersion could not say. A clamped
// value can never be offered: the caller has already refused the version.
fn ver_comp(text: &[u8], a: i64, b: i64, k: i64) -> i64 {
    let mut cur: i64 = 0;
    let mut digits: i64 = 0;
    let mut v: i64 = 0;
    let mut i: i64 = a;
    while i < b {
        let c: u8 = (*text)[i];
        if c == '.' {
            cur = cur + 1;
            digits = 0;
            0
        } else {
            if cur == k && is_digit(c) && digits < 9 {
                v = v * 10 + digit_val(c);
                digits = digits + 1;
                0
            } else { 0 };
            0
        };
        i = i + 1;
    }
    v
}

export "C" fn parse_appcast(body: &[u8], mine: &[u8]) -> [u8] {
    let bn: i64 = len(*body);
    let mn: i64 = len(*mine);

    // Locate sparkle:version="…". The C++ searched for the attribute name AND the
    // opening quote as ONE literal and took the first hit, so an unquoted
    // `sparkle:version=0.1.2` does not match and the scan continues past it — that is
    // what resuming at `at + 1` reproduces. Once an opening quote IS found the search
    // stops, exactly as find() does: a missing closing quote means no version, not
    // "go and look at the next item".
    let key: [u8] = "sparkle:version=";
    let klen: i64 = len(key);
    let mut found: bool = false;
    let mut va: i64 = 0;
    let mut vb: i64 = 0;
    let mut from: i64 = 0;
    let mut searching: bool = true;
    while searching {
        let at: i64 = find_lit(body, from, bn, &key);
        let mut next: i64 = 0 - 1;                 // where to resume; -1 = stop
        if at < 0 { 0 } else {
            if at + klen < bn && (*body)[at + klen] == '"' {
                let s: i64 = at + klen + 1;
                let mut q: i64 = s;
                let mut hasq: bool = false;
                while q < bn && hasq == false {
                    if (*body)[q] == '"' { hasq = true; 0 } else { q = q + 1; 0 };
                }
                if hasq { found = true; va = s; vb = q; 0 } else { 0 };
                0
            } else {
                next = at + 1;
                0
            };
            0
        };
        searching = next >= 0;
        from = next;
    }

    // Validate before anything downstream looks at these bytes. The offer dialog, the
    // log line and settings.ini's [update] skip_version all read the string this
    // returns, and it is returned only when this passes — so there is no path by which
    // unvalidated feed bytes reach the user or the disk.
    let mut valid: bool = false;
    if found { valid = ver_valid(body, va, vb); 0 } else { 0 };

    // Compare component by component, numerically — which is the whole point: a string
    // compare puts 0.1.10 BEFORE 0.1.9 and the project has already been bitten by that
    // once (see the releases table in docs/HANDOVER.md).
    //
    // `mine` is the running build's own version. If OUR side does not parse we cannot
    // compare at all, and then nothing is newer: fail closed on both sides, never
    // "assume an update".
    let mut newer: bool = false;
    if valid && ver_valid(mine, 0, mn) {
        let mut k: i64 = 0;
        let mut decided: bool = false;
        while k < 4 && decided == false {
            let x: i64 = ver_comp(body, va, vb, k);
            let y: i64 = ver_comp(mine, 0, mn, k);
            if x != y { newer = x > y; decided = true; 0 } else { 0 };
            k = k + 1;
        }
        0
    } else { 0 };

    let mut out: Vec<u8> = vec_new();
    if found { push(&mut out, i64_to_u8(1)); 0 } else { push(&mut out, i64_to_u8(0)); 0 };
    if valid { push(&mut out, i64_to_u8(1)); 0 } else { push(&mut out, i64_to_u8(0)); 0 };
    if newer { push(&mut out, i64_to_u8(1)); 0 } else { push(&mut out, i64_to_u8(0)); 0 };
    // The version bytes ONLY when valid. An invalid version is not returned at all, so
    // the host has nothing to show, log or persist even if it forgot to check `valid`.
    if valid { push_lenpref(&mut out, body, va, vb); 0 } else { push_le8(&mut out, 0); 0 };
    vec_to_array(out)
}
